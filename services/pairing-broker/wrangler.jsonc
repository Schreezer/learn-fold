{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "litter-pairing-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRING_REQUESTS",
        "class_name": "PairingRequest"
      }
    ]
  },
  "exports": {
    "PairingRequest": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "PAIRING_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
